generator client {
  provider = "prisma-client-js"
}

datasource db {
  // 生产部署使用 PostgreSQL，连接串统一从 DATABASE_URL 读取。
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id              String              @id @default(cuid())
  name            String
  brandName       String
  officialWebsite String?
  phone           String?
  address         String?
  competitorNames String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  keywords        Keyword[]
  questions       GeneratedQuestion[]
  responses       AiResponse[]
  scheduledTasks  ScheduledTask[]

  @@index([createdAt])
}

model Keyword {
  id        String              @id @default(cuid())
  projectId String
  text      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions GeneratedQuestion[]
  responses AiResponse[]

  @@unique([projectId, text])
  @@index([projectId])
}

model GeneratedQuestion {
  id        String       @id @default(cuid())
  projectId String
  keywordId String
  question  String
  createdAt DateTime     @default(now())

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword   Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  responses AiResponse[]

  @@unique([keywordId, question])
  @@index([projectId])
}

model AiProvider {
  id          String       @id @default(cuid())
  name        String       @unique
  displayName String
  baseUrlEnv  String
  apiKeyEnv   String
  modelEnv    String
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  responses   AiResponse[]
}

model AiResponse {
  id            String          @id @default(cuid())
  projectId     String
  keywordId     String
  questionId    String
  providerId    String?
  providerName  String
  modelName     String?
  fullAnswer    String?
  calledAt      DateTime        @default(now())
  success       Boolean
  failureReason String?

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword       Keyword         @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  question      GeneratedQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  provider      AiProvider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  exposureCheck ExposureCheck?

  @@index([projectId, calledAt])
  @@index([providerName])
  @@index([success])
}

model ExposureCheck {
  id                   String   @id @default(cuid())
  responseId           String   @unique
  brandMentioned       Boolean
  websiteMentioned     Boolean
  phoneMentioned       Boolean
  addressMentioned     Boolean
  brandMentionCount    Int
  brandPosition        String
  competitorMentioned  Boolean
  matchedCompetitors   String   @default("[]")
  score                Int
  checkedAt            DateTime @default(now())

  response             AiResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([brandMentioned])
}

model ScheduledTask {
  id          String    @id @default(cuid())
  projectId   String
  frequency   String
  cronExpr    String
  enabled     Boolean   @default(false)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([enabled])
}
